rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // La primera versión es privada por usuario. No permite acceso público.
    match /devices/{deviceId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && deviceId.matches('^' + request.auth.uid + '_.*$');
      allow read, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
    }
    match /observations/{observationId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
